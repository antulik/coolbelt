# Inspired by https://github.com/ViewComponent/view_component/issues/1064
namespace :view_component do
  namespace :stimulus_manifest do
    task display: :environment do
      LeanEngineApp.components_paths.map do |path|
        puts Stimulus::Manifest.generate_from(path)
      end
    end

    task update: :environment do
      dest_dir = Rails.root.join("app/javascript/controllers")

      manifest = LeanEngineApp.components_paths.map do |path|
        manifest = Stimulus::Manifest.generate_from(path)

        prefix = path.relative_path_from(dest_dir)
        manifest.map do |str|
          str.gsub('from "./', %(from "#{prefix}/))
        end
      end

      File.open(dest_dir.join("engine_components.js"), "w+") do |index|
        index.puts "// This file is auto-generated by ./bin/rails view_component:stimulus_manifest:update"
        index.puts "// Run that command whenever you add a new controller in ViewComponent"
        index.puts
        index.puts %(import { application } from "./application")
        index.puts manifest
      end

      dest_dir = Rails.root.join("app/assets/stylesheets")

      css_files = LeanEngineApp.components_paths.map do |path|
        # get all css files under apps/main_app/app/components
        css_files = path.glob("**/*.css")
        # remove the path
        css_files = css_files.map { |file| file.relative_path_from(dest_dir) }
        # remove self reference
        css_files = css_files.reject { |file| file == "./components.css" }
        # remove .css extension
        css_files = css_files.map { |file| file.sub(/\.css\z/, "") }
        # wrap each item in a css import
        css_files = css_files.map { |file| "@import '#{file}';" }

        css_files
      end

      File.open(dest_dir.join("engine_components.scss"), "w+") do |index|
        index.puts "/* This file is auto-generated by ./bin/rails view_component:stimulus_manifest:update */"
        index.puts "/* Run that command whenever you add a new controller in ViewComponent */"
        index.puts
        index.puts css_files
      end
    end
  end
end

if Rake::Task.task_defined?("stimulus:manifest:update")
  Rake::Task["stimulus:manifest:update"].enhance do
    Rake::Task["view_component:stimulus_manifest:update"].invoke
  end
end
